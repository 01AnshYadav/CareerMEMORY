# Copy this file to .env and fill in your real values. Never commit real secrets.
# Local development defaults. In production (Render) set these via the dashboard.

# Required. Your NVIDIA NIM API key.
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional. Model used for structured extraction. Defaults to the value in main.py.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional. Comma-separated list of allowed frontend origins (production Vercel URL).
# Localhost:3000 is always allowed for development.
FRONTEND_URL=http://localhost:3000

# Optional. Absolute path to the SQLite database file. Empty/unset keeps the
# default location next to backend/db.py. In production point this at a
# persistent disk mount (e.g. /var/data/careermemory.db).
DATABASE_PATH=